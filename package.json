{
  "name": "shuvromed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:scale": "DB_SCALE=1 vitest run --config vitest.db.config.ts supabase/tests/scale.test.ts",
    "test:scale": "vitest run --config vitest.scale.config.ts",
    "typecheck": "tsc -b",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:import": "tsx scripts/import-content.ts",
    "predev": "npm run content:build",
    "prebuild": "npm run content:build",
    "test:backup": "bash scripts/test-backup.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
